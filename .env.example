# Переименуй в .env при необходимости; все значения с дефолтами подставит compose.

# Вход через bebradio (пусто — авторизация выключена, standalone-режим)
AUTH_JWT_SECRET=

# GPU-микросервис (host-порт машины с torch/whisper; в compose по умолчанию host.docker.internal:8001)
KARAOKE_ML_SERVICE_URL=http://127.0.0.1:8001

# Объектное хранилище (Silo/S3, community-форк MinIO). Пустой S3_ENDPOINT — штатный AWS boto3 (нужно для тестов).
# Данные песен: бакет S3_BUCKET, ключи songs/<id>/... и music/...
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=siloadmin
S3_SECRET_KEY=siloadmin
S3_BUCKET=karaoke
# S3_REGION=

LOG_LEVEL=INFO
MAX_UPLOAD_MB=1024
MAX_BUNDLE_MB=2048
