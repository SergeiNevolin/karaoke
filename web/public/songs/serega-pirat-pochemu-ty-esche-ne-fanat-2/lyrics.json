06.94, "p": 0.817}]}, {"start": 106.94, "end": 109.26, "text": "Да я ебаный гуру, о нет", "words": [{"w": "Да", "s": 106.94, "e": 107.14, "p": 0.324}, {"w": "я", "s": 107.14, "e": 107.62, "p": 0.801}, {"w": "ебаный", "s": 107.62, "e": 108.34, "p": 0.904}, {"w": "гуру,", "s": 108.34, "e": 108.68, "p": 0.993}, {"w": "о", "s": 108.82, "e": 108.98, "p": 0.991}, {"w": "нет", "s": 108.98, "e": 109.26, "p": 0.98}]}, {"start": 109.26, "end": 111.2, "text": "Ты такой архикар", "words": [{"w": "Ты", "s": 109.26, "e": 109.82, "p": 0.966}, {"w": "такой", "s": 109.82, "e": 110.22, "p": 0.542}, {"w": "архикар", "s": 110.22, "e": 111.2, "p": 0.922}]}, {"start": 111.2, "end": 113.32, "text": "Он на камура, но с тобою", "words": [{"w": "Он", "s": 111.2, "e": 111.5, "p": 0.05}, {"w": "на", "s": 111.5, "e": 111.68, "p": 0.528}, {"w": "камура,", "s": 111.68, "e": 112.38, "p": 0.379}, {"w": "но", "s": 112.38, "e": 112.56, "p": 0.788}, {"w": "с", "s": 112.56, "e": 112.72, "p": 0.993}, {"w": "тобою", "s": 112.72, "e": 113.32, "p": 0.981}]}, {"start": 113.32, "end": 115.22, "text": "Не грузит тот ещё", "words": [{"w": "Не", "s": 113.32, "e": 113.7, "p": 0.418}, {"w": "грузит", "s": 113.7, "e": 114.24, "p": 0.783}, {"w": "тот", "s": 114.24, "e": 114.56, "p": 0.427}, {"w": "ещё", "s": 114.56, "e": 115.22, "p": 0.504}]}, {"start": 115.22, "end": 116.56, "text": "Зануда, о нет", "words": [{"w": "Зануда,", "s": 115.22, "e": 115.9, "p": 0.668}, {"w": "о", "s": 116.06, "e": 116.22, "p": 0.999}, {"w": "нет", "s": 116.22, "e": 116.56, "p": 0.999}]}, {"start": 116.56, "end": 119.78, "text": "Ну почему ты ещё не фанат?", "words": [{"w": "Ну", "s": 116.56, "e": 117.6, "p": 0.587}, {"w": "почему", "s": 117.8, "e": 118.26, "p": 0.992}, {"w": "ты", "s": 118.26, "e": 118.74, "p": 0.998}, {"w": "ещё", "s": 118.74, "e": 119.12, "p": 0.99}, {"w": "не", "s": 119.12, "e": 119.38, "p": 0.979}, {"w": "фанат?", "s": 119.38, "e": 119.78, "p": 0.98}]}, {"start": 121.5, "end": 122.3, "text": "Неужели", "words": [{"w": "Неужели", "s": 121.5, "e": 122.3, "p": 1.0}]}, {"start": 122.3, "end": 124.04, "text": "Не видишь таланта?", "words": [{"w": "Не", "s": 122.3, "e": 122.56, "p": 0.32}, {"w": "видишь", "s": 122.56, "e": 123.12, "p": 0.997}, {"w": "таланта?", "s": 123.12, "e": 124.04, "p": 0.998}]}, {"start": 124.79, "end": 126.23, "text": "Тебя трахает", "words": [{"w": "Тебя", "s": 124.79, "e": 125.59, "p": 0.988}, {"w": "трахает", "s": 125.59, "e": 126.23, "p": 0.945}]}, {"start": 126.23, "end": 127.25, "text": "Кушать пират", "words": [{"w": "Кушать", "s": 126.23, "e": 126.75, "p": 0.389}, {"w": "пират", "s": 126.75, "e": 127.25, "p": 0.898}]}, {"start": 127.25, "end": 130.1, "text": "Я же знаю, что тебе", "words": [{"w": "Я", "s": 127.25, "e": 128.31, "p": 0.962}, {"w": "же", "s": 128.92, "e": 129.16, "p": 0.978}, {"w": "знаю,", "s": 129.16, "e": 129.56, "p": 0.996}, {"w": "что", "s": 129.56, "e": 129.82, "p": 0.999}, {"w": "тебе", "s": 129.82, "e": 130.1, "p": 0.979}]}, {"start": 130.1, "end": 134.63, "text": "Тебе приятно, почему ты еще не фанат?", "words": [{"w": "Тебе", "s": 130.1, "e": 130.4, "p": 0.845}, {"w": "приятно,", "s": 130.4, "e": 131.24, "p": 0.998}, {"w": "почему", "s": 131.26, "e": 132.64, "p": 0.826}, {"w": "ты", "s": 132.73, "e": 133.29, "p": 0.973}, {"w": "еще", "s": 133.29, "e": 133.65, "p": 0.702}, {"w": "не", "s": 133.65, "e": 133.97, "p": 0.998}, {"w": "фанат?", "s": 133.97, "e": 134.63, "p": 0.967}]}, {"start": 136.03, "end": 138.63, "text": "Неужели не видишь таланта?", "words": [{"w": "Неужели", "s": 136.03, "e": 136.91, "p": 0.999}, {"w": "не", "s": 136.91, "e": 137.11, "p": 0.798}, {"w": "видишь", "s": 137.11, "e": 137.69, "p": 0.957}, {"w": "таланта?", "s": 137.69, "e": 138.63, "p": 0.999}]}, {"start": 139.68, "end": 141.76, "text": "Тебя трахает душа, ты рад", "words": [{"w": "Тебя", "s": 139.68, "e": 140.12, "p": 0.997}, {"w": "трахает", "s": 140.12, "e": 140.74, "p": 0.986}, {"w": "душа,", "s": 140.74, "e": 141.28, "p": 0.903}, {"w": "ты", "s": 141.28, "e": 141.44, "p": 0.855}, {"w": "рад", "s": 141.44, "e": 141.76, "p": 0.801}]}, {"start": 141.76, "end": 145.65, "text": "Я же знаю, что тебе приятно", "words": [{"w": "Я", "s": 141.76, "e": 142.84, "p": 0.174}, {"w": "же", "s": 143.45, "e": 143.65, "p": 0.544}, {"w": "знаю,", "s": 143.65, "e": 144.09, "p": 0.994}, {"w": "что", "s": 144.09, "e": 144.35, "p": 0.997}, {"w": "тебе", "s": 144.35, "e": 144.67, "p": 0.998}, {"w": "приятно", "s": 144.67, "e": 145.65, "p": 1.0}]}]}