": 36.56, "e": 37.74, "p": 0.857}, {"w": "не,", "s": 37.78, "e": 38.02, "p": 0.762}, {"w": "ну,", "s": 38.1, "e": 38.28, "p": 0.954}]}, {"start": 38.28, "end": 43.3, "text": "Но это вряд ли да, я будто галкин, мне не любят бабки", "words": [{"w": "Но", "s": 38.28, "e": 38.36, "p": 0.571}, {"w": "это", "s": 38.36, "e": 38.8, "p": 0.949}, {"w": "вряд", "s": 38.8, "e": 39.38, "p": 0.841}, {"w": "ли", "s": 39.38, "e": 39.62, "p": 0.918}, {"w": "да,", "s": 39.62, "e": 39.9, "p": 0.331}, {"w": "я", "s": 39.92, "e": 40.1, "p": 0.796}, {"w": "будто", "s": 40.1, "e": 40.44, "p": 0.924}, {"w": "галкин,", "s": 40.44, "e": 41.58, "p": 0.87}, {"w": "мне", "s": 41.58, "e": 41.8, "p": 0.286}, {"w": "не", "s": 41.8, "e": 41.92, "p": 0.967}, {"w": "любят", "s": 41.92, "e": 42.5, "p": 0.981}, {"w": "бабки", "s": 42.5, "e": 43.3, "p": 0.998}]}, {"start": 43.3, "end": 47.2, "text": "Да, меня бесит фэйм, бум, снова поставил цель, бум", "words": [{"w": "Да,", "s": 43.3, "e": 43.92, "p": 0.258}, {"w": "меня", "s": 44.02, "e": 44.16, "p": 0.861}, {"w": "бесит", "s": 44.16, "e": 44.58, "p": 0.998}, {"w": "фэйм,", "s": 44.58, "e": 45.0, "p": 0.756}, {"w": "бум,", "s": 45.08, "e": 45.34, "p": 0.638}, {"w": "снова", "s": 45.44, "e": 45.78, "p": 0.941}, {"w": "поставил", "s": 45.78, "e": 46.48, "p": 0.996}, {"w": "цель,", "s": 46.48, "e": 46.82, "p": 0.998}, {"w": "бум", "s": 46.88, "e": 47.2, "p": 0.998}]}, {"start": 47.2, "end": 50.26, "text": "У меня миллион идей, бум, люди хотят ещё", "words": [{"w": "У", "s": 47.2, "e": 47.44, "p": 0.74}, {"w": "меня", "s": 47.44, "e": 47.62, "p": 0.993}, {"w": "миллион", "s": 47.62, "e": 48.14, "p": 0.882}, {"w": "идей,", "s": 48.14, "e": 48.56, "p": 0.993}, {"w": "бум,", "s": 48.66, "e": 49.0, "p": 1.0}, {"w": "люди", "s": 49.1, "e": 49.4, "p": 0.995}, {"w": "хотят", "s": 49.4, "e": 49.9, "p": 0.996}, {"w": "ещё", "s": 49.9, "e": 50.26, "p": 0.623}]}, {"start": 50.26, "end": 54.64, "text": "Вся моя жизнь фристайл, снова наваливаю стайл", "words": [{"w": 