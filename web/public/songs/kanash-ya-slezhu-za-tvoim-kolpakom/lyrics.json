, "p": 0.947}, {"w": "подругой", "s": 69.42, "e": 70.02, "p": 0.992}]}, {"start": 70.02, "end": 70.9, "text": "Стыкай", "words": [{"w": "Стыкай", "s": 70.02, "e": 70.9, "p": 0.631}]}, {"start": 71.7, "end": 73.72, "text": "Когда вам не колышет", "words": [{"w": "Когда", "s": 71.7, "e": 72.38, "p": 0.173}, {"w": "вам", "s": 72.38, "e": 72.8, "p": 0.934}, {"w": "не", "s": 72.8, "e": 73.02, "p": 0.439}, {"w": "колышет", "s": 73.02, "e": 73.72, "p": 0.839}]}, {"start": 76.8, "end": 78.72, "text": "Забудь боль, браза, слышь", "words": [{"w": "Забудь", "s": 76.8, "e": 77.36, "p": 0.647}, {"w": "боль,", "s": 77.36, "e": 77.6, "p": 0.979}, {"w": "браза,", "s": 77.74, "e": 78.2, "p": 0.745}, {"w": "слышь", "s": 78.28, "e": 78.72, "p": 0.98}]}, {"start": 78.72, "end": 80.42, "text": "Такит будет сотня тысяч", "words": [{"w": "Такит", "s": 78.72, "e": 79.24, "p": 0.361}, {"w": "будет", "s": 79.24, "e": 79.5, "p": 0.959}, {"w": "сотня", "s": 79.5, "e": 80.12, "p": 0.964}, {"w": "тысяч", "s": 80.12, "e": 80.42, "p": 0.877}]}, {"start": 80.42, "end": 82.32, "text": "Не пью крепкий алкоголь", "words": [{"w": "Не", "s": 80.42, "e": 80.78, "p": 0.97}, {"w": "пью", "s": 80.78, "e": 81.08, "p": 0.994}, {"w": "крепкий", "s": 81.08, "e": 81.54, "p": 0.989}, {"w": "алкоголь", "s": 81.54, "e": 82.32, "p": 0.999}]}, {"start": 82.32, "end": 84.12, "text": "Я, я, я, я и так крепыш", "words": [{"w": "Я,", "s": 82.32, "e": 82.46, "p": 0.858}, {"w": "я,", "s": 82.5, "e": 82.74, "p": 0.981}, {"w": "я,", "s": 82.74, "e": 82.96, "p": 0.998}, {"w": "я", "s": 82.96, "e": 83.12, "p": 0.996}, {"w": "и", "s": 83.12, "e": 83.32, "p": 0.799}, {"w": "так", "s": 83.32, "e": 83.6, "p": 0.966}, {"w": "крепыш", "s": 83.6, "e": 84.12, "p": 0.974}]}, {"start": 84.12, "end": 86.14, "text": "Забудь боль, браза, слышь", "words": [{"w": "Забудь", "s": 84.12, "e": 84.76, "p": 0.998}, {"w": "боль,", "s": 84.76, "e": 85.04, "p": 1.0}, {"w": "браза,", "s": 85.14, "e": 85.56, "p": 1.0}, {"w": "слышь", "s": 85.64, "e": 8