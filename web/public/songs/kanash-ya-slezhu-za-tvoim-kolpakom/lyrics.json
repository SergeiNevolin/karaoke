{"language": "ru", "segments": [{"start": 16.56, "end": 18.3, "text": "Музыкант, музыкант, музыкант, музыкант", "words": [{"w": "Музыкант,", "s": 16.56, "e": 16.98, "p": 0.828}, {"w": "музыкант,", "s": 16.98, "e": 17.46, "p": 0.945}, {"w": "музыкант,", "s": 17.46, "e": 17.9, "p": 0.995}, {"w": "музыкант", "s": 17.9, "e": 18.3, "p": 0.964}]}, {"start": 18.3, "end": 19.34, "text": "Бьёт нам толпаки", "words": [{"w": "Бьёт", "s": 18.3, "e": 18.56, "p": 0.55}, {"w": "нам", "s": 18.56, "e": 18.78, "p": 0.984}, {"w": "толпаки", "s": 18.78, "e": 19.34, "p": 0.927}]}, {"start": 19.34, "end": 21.24, "text": "Слышь, соберись, натяни парки", "words": [{"w": "Слышь,", "s": 19.34, "e": 20.02, "p": 0.905}, {"w": "соберись,", "s": 20.02, "e": 20.42, "p": 0.984}, {"w": "натяни", "s": 20.44, "e": 20.7, "p": 0.946}, {"w": "парки", "s": 20.7, "e": 21.24, "p": 0.384}]}, {"start": 21.24, "end": 23.12, "text": "Покажи своё имя внутри толпы", "words": [{"w": "Покажи", "s": 21.24, "e": 21.64, "p": 0.936}, {"w": "своё", "s": 21.64, "e": 22.1, "p": 0.846}, {"w": "имя", "s": 22.1, "e": 22.28, "p": 0.997}, {"w": "внутри", "s": 22.28, "e": 22.46, "p": 0.727}, {"w": "толпы", "s": 22.46, "e": 23.12, "p": 0.943}]}, {"start": 23.12, "end": 24.86, "text": "Нам на всё взять из расплаты", "words": [{"w": "Нам", "s": 23.12, "e": 23.36, "p": 0.942}, {"w": "на", "s": 23.36, "e": 23.54, "p": 0.959}, {"w": "всё", "s": 23.54, "e": 23.8, "p": 0.952}, {"w": "взять", "s": 23.8, "e": 24.1, "p": 0.891}, {"w": "из", "s": 24.1, "e": 24.34, "p": 0.526}, {"w": "расплаты", "s": 24.34, "e": 24.86, "p": 0.816}]}, {"start": 24.86, "end": 26.88, "text": "Я в эндерме, как мастер-дон", "words": [{"w": "Я", "s": 24.86, "e": 25.12, "p": 0.896}, {"w": "в", "s": 25.12, "e": 25.34, "p": 0.976}, {"w": "эндерме,", "s": 25.34, "e": 25.92, "p": 0.646}, {"w": "как", "s": 25.96, "e": 26.12, "p": 0.947}, {"w": "мастер", "s": 26.12, "e": 26.54, "p": 0.666}, {"w": "-дон", "s": 26.54, "e": 26.88, "p": 0.649}]}, {"start": 26.88, "end": 28