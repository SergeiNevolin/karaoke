": 46.42, "p": 0.895}, {"w": "всех", "s": 46.42, "e": 46.64, "p": 0.954}, {"w": "пиздвяк", "s": 46.64, "e": 47.26, "p": 0.515}]}, {"start": 47.26, "end": 49.94, "text": "Я чувств, чувств, пульс, ныряю в её луны", "words": [{"w": "Я", "s": 47.26, "e": 47.56, "p": 0.422}, {"w": "чувств,", "s": 47.56, "e": 48.08, "p": 0.289}, {"w": "чувств,", "s": 48.24, "e": 48.5, "p": 0.931}, {"w": "пульс,", "s": 48.58, "e": 49.16, "p": 0.972}, {"w": "ныряю", "s": 49.16, "e": 49.52, "p": 0.935}, {"w": "в", "s": 49.52, "e": 49.62, "p": 0.904}, {"w": "её", "s": 49.62, "e": 49.72, "p": 0.157}, {"w": "луны", "s": 49.72, "e": 49.94, "p": 0.954}]}, {"start": 49.94, "end": 51.46, "text": "Я скоро вернусь, она знает всё", "words": [{"w": "Я", "s": 49.94, "e": 50.1, "p": 0.269}, {"w": "скоро", "s": 50.1, "e": 50.34, "p": 0.952}, {"w": "вернусь,", "s": 50.34, "e": 50.98, "p": 0.997}, {"w": "она", "s": 50.98, "e": 51.08, "p": 0.778}, {"w": "знает", "s": 51.08, "e": 51.3, "p": 0.993}, {"w": "всё", "s": 51.3, "e": 51.46, "p": 0.446}]}, {"start": 51.46, "end": 53.66, "text": "У меня есть спецсвязь, чтоб сделать грязь", "words": [{"w": "У", "s": 51.46, "e": 51.68, "p": 0.543}, {"w": "меня", "s": 51.68, "e": 51.9, "p": 0.997}, {"w": "есть", "s": 51.9, "e": 52.24, "p": 0.99}, {"w": "спецсвязь,", "s": 52.24, "e": 52.74, "p": 0.964}, {"w": "чтоб", "s": 52.74, "e": 52.88, "p": 0.708}, {"w": "сделать", "s": 52.88, "e": 53.18, "p": 0.94}, {"w": "грязь", "s": 53.18, "e": 53.66, "p": 0.674}]}, {"start": 53.66, "end": 54.8, "text": "И на карте плюсы", "words": [{"w": "И", "s": 53.66, "e": 53.72, "p": 0.279}, {"w": "на", "s": 53.72, "e": 53.82, "p": 0.989}, {"w": "карте", "s": 53.82, "e": 54.3, "p": 0.994}, {"w": "плюсы", "s": 54.3, "e": 54.8, "p": 0.553}]}, {"start": 55.28, "end": 57.32, "text": "Чувств, чувств, пульс, ныряю в её луны", "words": [{"w": "Чувств,", "s": 55.28, "e": 55.62, "p": 0.615}, {"w": "чувств,", "s": 55.62, "e": 55.96, "p": 0.528}, {"w": "пульс,", "s": 55.98, "e": 56.54, "p": 0.999}, {"w