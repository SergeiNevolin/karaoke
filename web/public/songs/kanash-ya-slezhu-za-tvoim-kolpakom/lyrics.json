.0, "e": 97.28, "p": 0.82}, {"w": "верка", "s": 97.32, "e": 97.68, "p": 0.866}]}, {"start": 97.68, "end": 99.52, "text": "Хоть я папа по твоим меркам", "words": [{"w": "Хоть", "s": 97.68, "e": 98.04, "p": 0.99}, {"w": "я", "s": 98.04, "e": 98.16, "p": 1.0}, {"w": "папа", "s": 98.16, "e": 98.54, "p": 0.958}, {"w": "по", "s": 98.54, "e": 98.7, "p": 0.633}, {"w": "твоим", "s": 98.7, "e": 99.14, "p": 0.843}, {"w": "меркам", "s": 99.14, "e": 99.52, "p": 0.894}]}, {"start": 99.52, "end": 101.26, "text": "Где плавал камни, шамелка", "words": [{"w": "Где", "s": 99.52, "e": 100.02, "p": 0.769}, {"w": "плавал", "s": 100.02, "e": 100.42, "p": 0.994}, {"w": "камни,", "s": 100.42, "e": 100.74, "p": 0.518}, {"w": "шамелка", "s": 100.74, "e": 101.26, "p": 0.654}]}, {"start": 101.26, "end": 103.2, "text": "Ты, ты, ты со мной тогда, велкам", "words": [{"w": "Ты,", "s": 101.26, "e": 101.58, "p": 0.976}, {"w": "ты,", "s": 101.64, "e": 101.86, "p": 1.0}, {"w": "ты", "s": 101.86, "e": 102.0, "p": 1.0}, {"w": "со", "s": 102.0, "e": 102.16, "p": 0.997}, {"w": "мной", "s": 102.16, "e": 102.42, "p": 0.999}, {"w": "тогда,", "s": 102.42, "e": 102.62, "p": 0.648}, {"w": "велкам", "s": 102.7, "e": 103.2, "p": 0.851}]}, {"start": 103.2, "end": 106.64, "text": "Если не поёшь рэпом, то всегда есть выход на вау", "words": [{"w": "Если", "s": 103.2, "e": 103.8, "p": 0.141}, {"w": "не", "s": 103.8, "e": 104.22, "p": 0.981}, {"w": "поёшь", "s": 104.22, "e": 104.64, "p": 0.615}, {"w": "рэпом,", "s": 104.64, "e": 105.12, "p": 0.991}, {"w": "то", "s": 105.12, "e": 105.28, "p": 0.883}, {"w": "всегда", "s": 105.28, "e": 105.6, "p": 0.989}, {"w": "есть", "s": 105.6, "e": 105.9, "p": 0.965}, {"w": "выход", "s": 105.9, "e": 106.16, "p": 0.992}, {"w": "на", "s": 106.16, "e": 106.42, "p": 0.446}, {"w": "вау", "s": 106.42, "e": 106.64, "p": 0.374}]}, {"start": 111.62, "end": 128.75, "text": "Лау Кома, сквозь бомбу", "words": [{"w": "Лау", "s": 111.62, "e": 112.3, "p": 0.277}, {"w": "Кома,", "s": 112.3, "e": 112.98, "p": 0.503}, {"w": "сквозь", "s": 112.98, "e": 123.38, "p": 0.856}, {"w": "бомбу", "s": 128.05, "e": 128.75, "p": 0.333}]}, {"start": 128.75, "end": 130.25, "text": "Музыка орвёт нам толпаки", "words": [{"w": "Музыка", "s": 128.75, "e": 128.97, "p": 0.908}, {"w": "орвёт", "s": 128.97, "e": 129.31, "p": 0.723}, {"w": "нам", "s": 129.31, "e": 129.55, "p": 0.992}, {"w": "толпаки", "s": 129.55, "e": 130.25, "p": 0.973}]}, {"start": 130.25, "end": 132.01, "text": "Слышь, соберись, надени парки", "words": [{"w": "Слышь,", "s": 130.25, "e": 130.79, "p": 0.654}, {"w": "соберись,", "s": 130.79, "e": 131.21, "p": 0.957}, {"w": "надени", "s": 131.21, "e": 131.51, "p": 0.566}, {"w": "парки", "s": 131.51, "e": 132.01, "p": 0.57}]}, {"start": 132.01, "end": 133.91, "text": "Покажи своими внутренней толпой", "words": [{"w": "Покажи", "s": 132.01, "e": 132.43, "p": 0.929}, {"w": "своими", "s": 132.43, "e": 132.97, "p": 0.717}, {"w": "внутренней", "s": 132.97, "e": 133.47, "p": 0.727}, {"w": "толпой", "s": 133.47, "e": 133.91, "p": 0.939}]}, {"start": 133.91, "end": 135.63, "text": "Нам на всё взять из расплаты", "words": [{"w": "Нам", "s": 133.91, "e": 134.15, "p": 0.926}, {"w": "на", "s": 134.15, "e": 134.31, "p": 0.897}, {"w": "всё", "s": 134.31, "e": 134.57, "p": 0.98}, {"w": "взять", "s": 134.57, "e": 134.87, "p": 0.88}, {"w": "из", "s": 134.87, "e": 135.09, "p": 0.726}, {"w": "расплаты", "s": 135.09, "e": 135.63, "p": 0.781}]}, {"start": 135.63, "end": 137.65, "text": "Я в эндерме, как Мастер Дон", "words": [{"w": "Я", "s": 135.63, "e": 135.91, "p": 0.981}, {"w": "в", "s": 135.91, "e": 136.07, "p": 0.883}, {"w": "эндерме,", "s": 136.07, "e": 136.65, "p": 0.78}, {"w": "как", "s": 136.69, "e": 136.91, "p": 0.997}, {"w": "Мастер", "s": 136.91, "e": 137.31, "p": 0.755}, {"w": "Дон", "s": 137.31, "e": 137.65, "p": 0.943}]}, {"start": 137.65, "end": 140.57, "text": "Забрал кусок, потом весь торт со мной, мои братья", "words": [{"w": "Забрал", "s": 137.65, "e": 138.11, "p": 0.704}, {"w": "кусок,", "s": 138.11, "e": 138.63, "p": 0.995}, {"w": "потом", "s": 138.63, "e": 138.89, "p": 0.985}, {"w": "весь", "s": 138.89, "e": 139.19, "p": 0.583}, {"w": "торт", "s": 139.19, "e": 139.53, "p": 0.763}, {"w": "со", "s": 139.53, "e": 139.63, "p": 0.817}, {"w": "мной,", "s": 139.63, "e": 139.91, "p": 0.99}, {"w": "мои", "s": 139.95, "e": 140.19, "p": 0.39}, {"w": "братья", "s": 140.19, "e": 140.57, "p": 0.987}]}, {"start": 140.57, "end": 143.31, "text": "Как маслон, заряжать на коже, бьющий фрау", "words": [{"w": "Как", "s": 140.57, "e": 140.77, "p": 0.635}, {"w": "маслон,", "s": 140.77, "e": 141.35, "p": 0.653}, {"w": "заряжать", "s": 141.35, "e": 141.83, "p": 0.857}, {"w": "на", "s": 141.83, "e": 141.97, "p": 0.515}, {"w": "коже,", "s": 141.97, "e": 142.33, "p": 0.526}, {"w": "бьющий", "s": 142.45, "e": 142.87, "p": 0.847}, {"w": "фрау", "s": 142.87, "e": 143.31, "p": 0.931}]}, {"start": 143.31, "end": 146.77, "text": "За корбет нам полпаки, ты соберись, статини и баки", "words": [{"w": "За", "s": 143.31, "e": 143.61, "p": 0.722}, {"w": "корбет", "s": 143.61, "e": 144.15, "p": 0.694}, {"w": "нам", "s": 144.15, "e": 144.27, "p": 0.938}, {"w": "полпаки,", "s": 144.27, "e": 145.05, "p": 0.751}, {"w": "ты", "s": 145.07, "e": 145.37, "p": 0.59}, {"w": "соберись,", "s": 145.37, "e": 145.99, "p": 0.794}, {"w": "статини", "s": 145.99, "e": 146.31, "p": 0.7}, {"w": "и", "s": 146.31, "e": 146.41, "p": 0.479}, {"w": "баки", "s": 146.41, "e": 146.77, "p": 0.591}]}, {"start": 146.77, "end": 150.49, "text": "Покупи свои мертвые толпы, нам на все взять из расплаты", "words": [{"w": "Покупи", "s": 146.77, "e": 147.31, "p": 0.713}, {"w": "свои", "s": 147.31, "e": 147.51, "p": 0.275}, {"w": "мертвые", "s": 147.51, "e": 148.13, "p": 0.487}, {"w": "толпы,", "s": 148.13, "e": 148.73, "p": 0.918}, {"w": "нам", "s": 148.73, "e": 148.89, "p": 0.994}, {"w": "на", "s": 148.89, "e": 149.07, "p": 0.976}, {"w": "все", "s": 149.07, "e": 149.33, "p": 0.669}, {"w": "взять", "s": 149