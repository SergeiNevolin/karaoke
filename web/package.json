{
  "name": "karaoke-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bebradio": "vite --base=/karaoke/",
    "build": "tsc --noEmit && vite build",
    "build:bebradio": "tsc --noEmit && vite build --base=/karaoke/ --mode bebradio",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "export-songs": "cd .. && python -m karaoke_api.cli.export"
  },
  "dependencies": {
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "pitchy": "^4.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
